#:kivy 2.0.0

<Widget>:
    font_name: 'Roboto'

<Button>:
    background_normal: ''
    background_color: 0.2, 0.2, 0.2, 1
    color: 0.9, 0.9, 0.9, 1
    font_size: '14sp'

<Label>:
    color: 0.8, 0.8, 0.8, 1

<TabbedPanelItem>:
    background_normal: ''
    background_color: 0.15, 0.15, 0.15, 1
    color: 0.7, 0.7, 0.7, 1

<TabbedPanel>:
    background_color: 0.1, 0.1, 0.1, 1
    tab_width: 150

<Spinner>:
    background_normal: ''
    background_color: 0.25, 0.25, 0.25, 1

<RecycleView>:
    viewclass: 'SelectableLabel'
    SelectableLabel:
        height: dp(40)
        size_hint_y: None
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        padding_x: 10
        canvas.before:
            Color:
                rgba: (0.3, 0.3, 0.3, 1) if self.selected else (0.1, 0.1, 0.1, 1)
            Rectangle:
                pos: self.pos
                size: self.size
