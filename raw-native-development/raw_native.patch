+    "extract_capture_exif",
+    "extract_gps_tags",
+    "extract_dng_camera_tags",
+    "extract_root_capture_tags",
+    "extract_demosaic_parameters",
+    "extract_source_dng_metadata",
+    "_apply_baked_orientation",
+    "_baked_cfa_pattern",
+    "_plane_slice",
+    "_plane_homography",
+]

